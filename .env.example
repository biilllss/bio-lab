# ──────────────────────────────────────────────────────────────
# Bio Lab — environment template (PostgreSQL / Neon)
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# ⚠️ Never commit your real .env — it contains the database
# password. On Vercel, DATABASE_URL lives in Project → Settings
# → Environment Variables instead.
# ──────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (Prisma format).
# Get yours from the Neon console → Connection Details.
# Keep `?sslmode=require` — Neon enforces TLS.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXXXXX-pooler.region.aws.neon.tech/neondb?sslmode=require"

# NOTE — the biology lab itself is 100% client-side (progress lives
# in the browser's localStorage). The database is only used by the
# Prisma starter schema (User/Post) and future server features, so
# the app runs fine in dev even before this variable points anywhere
# reachable. To create the tables in your own database:
#     bun run db:generate
#     bun run db:push
