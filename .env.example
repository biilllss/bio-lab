# ──────────────────────────────────────────────────────────────
# Bio Lab — environment template
# Copy this file to `.env` and adjust if needed:
#     cp .env.example .env
#
# This is the ONLY variable the app needs. It is a local file
# path (not a secret) — no API keys are required to run locally.
# ──────────────────────────────────────────────────────────────

# SQLite database location used by Prisma.
#
# ⚠️ Relative paths are resolved relative to prisma/schema.prisma,
# NOT the folder you run the command from. Since the schema lives
# in prisma/, use "../db/…" to point at the db/ folder at the
# project root (the db/ folder must already exist):
#
DATABASE_URL=file:../db/custom.db
#
# Alternative — absolute path (what the sandbox uses):
#   DATABASE_URL=file:/absolute/path/to/my-project/db/custom.db
#
# The file itself does not need to exist: `bun run db:push`
# creates/syncs it from prisma/schema.prisma.
